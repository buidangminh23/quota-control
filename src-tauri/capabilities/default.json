{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the tray popup window",
  "windows": ["popup"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "notification:default",
    "global-shortcut:default",
    "autostart:default"
  ]
}

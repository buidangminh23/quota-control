{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Control",
  "version": "0.3.6",
  "identifier": "com.buidangminh.usagecontrol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQkU4RDMyNzYyREU0NjkKUldScDVDMTJNbzIra3phR0FyVUUrbkx5RFllOE44M0NSYWh0VGROUVRmT3c0SlEwOFUyQWllSXoK",
      "endpoints": ["https://github.com/buidangminh23/quota-control/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Utility",
    "publisher": "Bui Dang Minh",
    "shortDescription": "AI coding subscription limits in your system tray",
    "longDescription": "Quota Control is an unofficial Windows and Linux port of OpenUsage. It shows session and weekly limits, credits and local spend for Claude, Codex, Cursor and other AI coding tools in a popup that opens from the system tray.",
    "copyright": "Copyright (c) 2026 Robin Ebers (OpenUsage), Bui Dang Minh (Quota Control)",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Quota Control",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
